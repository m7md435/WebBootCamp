def calculate_grade(score):
    if not score.isdigit():
        return "Invalid input"
    score = int(score)
    if score >= 90:
      return "A"
    elif score >= 80:
       return "B"
    elif score >= 70:
       return "C"
    elif score >= 60:
       return "D"
    else:
       return "F"

print(calculate_grade("91"))
print(calculate_grade("85"))
print(calculate_grade("75"))
print(calculate_grade("65"))
print(calculate_grade("55"))
print(calculate_grade("invalid"))